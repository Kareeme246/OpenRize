{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRize",
  "bundle": {
    "targets": ["nsis"],
    "externalBin": ["binaries/rize"],
    "createUpdaterArtifacts": true,
    "publisher": "Offline Studios",
    "copyright": "Copyright (c) 2026 Offline Studios",
    "shortDescription": "Automatic, private, local-first time tracking",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
